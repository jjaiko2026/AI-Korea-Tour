# ── DB (Neon Serverless Postgres) ────────────────────────────────────────
DATABASE_URL=

# ── Clerk 인증 (§6.2) ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── AI (§6.4, §19, §39-41) — Vercel AI Gateway 경유 시 이 키 대신 게이트웨이 설정 사용 ──
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── YouTube Data API v3 (§13-14) ─────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCH_LIMIT=200
YOUTUBE_MAX_CONCURRENT_JOBS=3

# ── Naver 검색/지역 API (§24) ─────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_DAILY_SEARCH_LIMIT=500
NAVER_MAX_CONCURRENT_JOBS=3

# ── 한국관광공사 TourAPI KorService2 (§19.1, §63) — Rule 8.2: 서버 전용 ─────
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=
TOUR_API_DAILY_LIMIT=1000
TOUR_API_MAX_CONCURRENT_JOBS=5

# ── Google Maps/Geocoding (§20) ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Naver Maps JS SDK (§20, 클라이언트 노출용) ────────────────────────────
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=

# ── Cache TTL (§9, 일 단위) ───────────────────────────────────────────────
CACHE_TTL_YOUTUBE_DAYS=30
CACHE_TTL_BLOG_DAYS=14

# ── TourAPI TTL (§19.1.10) ────────────────────────────────────────────────
TOUR_TTL_AREA_CATEGORY_DAYS=30
TOUR_TTL_PLACE_BASIC_DAYS=7
TOUR_TTL_OPERATION_HOURS=24
TOUR_TTL_FESTIVAL_HOURS=6
TOUR_TTL_IMAGES_DAYS=7
TOUR_TTL_STAY_HOURS=24
TOUR_TTL_PET_TOUR_DAYS=7

# ── Content AI 운영 설정 (§49, §41.3) ─────────────────────────────────────
CONTENT_JOB_MAX_RETRIES=2
DEFAULT_SHORTS_COUNT=5
